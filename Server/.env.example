# Copy this file to .env and fill in the values. .env is gitignored.

# Google AI Studio key for Gemini. Required.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Comma-separated list of origins allowed to call /api/chat.
# Anything not listed here is rejected with 403.
ALLOWED_ORIGINS=https://princebhatt03.github.io,http://localhost:3000,http://127.0.0.1:5500

# Port for local development. Ignored on Vercel.
PORT=5000
